# AI Failure Analysis Copilot — Environment Configuration
# Copy this file to .env and fill in your values

# Required: Anthropic API key for Claude
ANTHROPIC_API_KEY=your-api-key-here

# Optional: Claude model to use (defaults to claude-sonnet-4-20250514)
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Optional: Max tokens for LLM response (defaults to 1024)
LLM_MAX_TOKENS=1024
