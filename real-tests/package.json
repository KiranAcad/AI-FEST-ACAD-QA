    "analyze:ollama": "npx tsx ../src/index.ts analyze --input ./test-results/results.json --output ../output/ollama-report --provider ollama --model qwen3:8b",
    "test:and:analyze": "playwright test || npx tsx ../src/index.ts analyze --input ./test-results/results.json --output ../output/real-test-report --dry-run",
    "test:and:analyze:ollama": "playwright test || npx tsx ../src/index.ts analyze --input ./test-results/results.json --output ../output/ollama-report --provider ollama --model qwen3:8b"
  },
